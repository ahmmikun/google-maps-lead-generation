{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleMapsLeadRecord",
  "description": "Schema definition for a Google Maps lead generated by the skill",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Normalized business or clinic name"
    },
    "category": {
      "type": "string",
      "description": "Google Maps category classification"
    },
    "phone": {
      "type": "string",
      "description": "Sanitized phone number without newline or font icon artifacts"
    },
    "address": {
      "type": "string",
      "description": "Sanitized street and city address without newline or font icon artifacts"
    },
    "rating": {
      "type": "string",
      "description": "Star rating score from 1.0 to 5.0"
    },
    "reviews": {
      "type": "string",
      "description": "Review count string, e.g. (87)"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "description": "Destination website or profile URL listed on Google Maps"
    },
    "website_type": {
      "type": "string",
      "enum": ["none", "social", "directory", "website"],
      "description": "Classified destination type"
    },
    "website_status": {
      "type": "string",
      "enum": [
        "no_website",
        "not_own_website",
        "up",
        "down_http_4xx",
        "down_http_5xx",
        "down_ssl_error",
        "down_dns_or_unreachable",
        "down_timeout",
        "down_redirect_loop",
        "down_connection_reset",
        "down_other"
      ],
      "description": "Reachability or health check outcome"
    },
    "website_status_code": {
      "type": ["integer", "string", "null"],
      "description": "HTTP status code returned during health check"
    },
    "website_status_detail": {
      "type": ["string", "null"],
      "description": "Error diagnostic detail if unreachable"
    },
    "lead_reason": {
      "type": "string",
      "description": "Outreach qualification rationale, e.g. no_website, no_own_website_social, website_down_http_4xx, has_website_up"
    },
    "place_url": {
      "type": "string",
      "format": "uri",
      "description": "Google Maps place canonical listing URL"
    },
    "source_query": {
      "type": "string",
      "description": "Search query that discovered this business"
    }
  },
  "required": [
    "business_name",
    "phone",
    "address",
    "website_type",
    "website_status",
    "lead_reason",
    "place_url",
    "source_query"
  ]
}
